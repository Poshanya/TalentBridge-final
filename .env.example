# Set these in your shell or hosting provider's environment-variable settings.
# DB_URL=jdbc:mysql://HOST:3306/talentbridge?sslMode=REQUIRED
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password
# Generate a random secret of at least 32 bytes and Base64-encode it.
JWT_SECRET=replace_with_base64_encoded_random_secret
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
DDL_AUTO=update
PORT=8080
